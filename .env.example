# Copiá este archivo como `.env` y completá los valores.
# NINGÚN valor real se commitea (ARQUITECTURA.md D-18). En producción, estas
# variables se cargan como "Environment Variables" en Cloudflare Pages.

# --- Sitio -------------------------------------------------------------------
# Dominio canónico del sitio. Afecta URLs canónicas, hreflang (RF-9),
# UTM (RF-10) y og:url. Sobrescribe el valor por defecto de astro.config.mjs.
PUBLIC_SITE_URL="https://elquelassabetodas.com"

# --- Analítica: GoatCounter (D-7 / D-15) -----------------------------------
# El "código" es el subdominio de tu cuenta: https://<CODIGO>.goatcounter.com
# Si se deja vacío, no se carga ningún script de analítica.
PUBLIC_GOATCOUNTER_CODE=""

# --- Formulario de contacto: Web3Forms (D-14 / sección 6) -----------------
# Access key de https://web3forms.com (se obtiene con el email de destino).
# Recepción final: contacto@elquelassabetodas.com vía Cloudflare Email Routing
# -> Gmail (D-6). El dominio debe verificarse en Web3Forms para que el redirect
# a /contacto/gracias funcione (paso manual del autor al configurar la cuenta).
PUBLIC_WEB3FORMS_ACCESS_KEY=""

# --- Anti-spam del formulario: Cloudflare Turnstile (sección 6) -----------
# Site key del widget (la secret key va en Web3Forms, no acá).
PUBLIC_TURNSTILE_SITE_KEY=""
