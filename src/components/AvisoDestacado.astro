---
/**
 * RF-11 / CA-12 — Banner del aviso ACTIVO más reciente, en la home.
 * Es una comunicación al lector, no un artículo de contenido: layout propio con
 * filete de acento, y NO aparece en ningún listado de artículos.
 */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { t } from '../i18n';
import { fechaLarga } from '../lib/fechas';

interface Props {
  aviso: CollectionEntry<'avisos'>;
}
const { aviso } = Astro.props;
const { Content } = await render(aviso);
---
<aside
  class="border-l-2 border-acento bg-superficie px-5 py-4 sm:px-6"
  role="note"
  aria-label={t('aviso.etiqueta')}
>
  <p class="m-0 font-mono text-[11px] uppercase tracking-[0.14em] text-acento">
    {t('aviso.etiqueta')} · <time datetime={aviso.data.fecha.toISOString().slice(0, 10)}>{fechaLarga(aviso.data.fecha)}</time>
  </p>
  <h2 class="mt-1 font-serif text-lg font-semibold text-tinta">{aviso.data.titulo}</h2>
  <div class="prose-aviso mt-2 space-y-3 text-sm text-tinta-suave">
    <Content />
  </div>
  <a href={`/aviso/${aviso.id}`} class="mt-3 inline-block border-b border-current text-sm text-acento">
    {t('aviso.verMas')} →
  </a>
</aside>
