---
/**
 * Tarjeta de artículo para listados (home, /recientes, /aprender, /profundizar,
 * /seccion/[seccion]). Marca el nivel, la(s) sección(es), y si tiene opinión
 * (RF-3: para poder identificarlo desde el listado).
 *
 * `variante`:
 *   - 'grilla' — thumbnail 16:9 + kicker + título + resumen; es la que se usa
 *     hoy en todos los listados y en "Lo último" de la home.
 *   - 'texto'  (default) — sin imagen, solo texto. Fallback.
 */
import { getEntries } from 'astro:content';
import { Image } from 'astro:assets';
import type { Articulo } from '../lib/articulos';
import { rutaArticulo } from '../lib/articulos';
import { dict } from '../i18n';
import { fechaLarga, mesAnio } from '../lib/fechas';

interface Props {
  articulo: Articulo;
  variante?: 'texto' | 'grilla';
}
const { articulo, variante = 'texto' } = Astro.props;
const d = articulo.data;
const secciones = await getEntries(d.secciones);
const nivel = dict().articulo.porNivel[d.nivel];
const tipo = dict().articulo.porTipo[d.tipoArticulo];
const hayActualizacion =
  !!d.fechaActualizacion && d.fechaActualizacion.getTime() > d.fechaPublicacion.getTime();
const kicker = d.tipoArticulo === 'analisis-caso' ? tipo : nivel;
const fecha = hayActualizacion
  ? `Actualizado en ${mesAnio(d.fechaActualizacion!)}`
  : fechaLarga(d.fechaPublicacion);
---
{variante === 'grilla' ? (
  <article class="group flex flex-col">
    <a href={rutaArticulo(articulo)} class="block">
      {d.portada &&
        (d.portada.format === 'svg' ? (
          <img
            src={d.portada.src}
            alt={d.portadaAlt ?? d.titulo}
            width={d.portada.width}
            height={d.portada.height}
            class="aspect-[16/9] w-full border border-borde object-cover"
          />
        ) : (
          <Image
            src={d.portada}
            alt={d.portadaAlt ?? d.titulo}
            width={640}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw"
            class="aspect-[16/9] w-full border border-borde object-cover"
          />
        ))}
      <p class="mt-3 font-mono text-[10.5px] font-medium uppercase tracking-[0.12em] text-tinta-tenue">
        {kicker}
        {secciones.length > 0 && <span> · {secciones.map((s) => s.data.nombre).join(' · ')}</span>}
      </p>
      <h3 class="mt-1.5 font-serif text-lg font-medium leading-snug text-tinta group-hover:text-acento">
        {d.titulo}
      </h3>
    </a>
    <p class="mt-2 line-clamp-3 text-sm text-tinta-suave">{d.resumen}</p>
    <p class="mt-2 text-xs text-tinta-tenue">
      {fecha}
      {d.tieneOpinion && <span> · con opinión</span>}
    </p>
  </article>
) : (
  <article class="border-t border-borde pt-5">
    <p class="font-mono text-[10.5px] font-medium uppercase tracking-[0.12em] text-tinta-tenue">
      {kicker}
      {secciones.length > 0 && <span> · {secciones.map((s) => s.data.nombre).join(' · ')}</span>}
    </p>
    <h3 class="mt-2 font-serif text-xl font-medium leading-snug">
      <a href={rutaArticulo(articulo)} class="text-tinta hover:text-acento">{d.titulo}</a>
    </h3>
    <p class="mt-2 text-tinta-suave">{d.resumen}</p>
    <p class="mt-2 text-sm text-tinta-tenue">
      {fecha}
      {d.tieneOpinion && <span> · con opinión del autor</span>}
    </p>
  </article>
)}
