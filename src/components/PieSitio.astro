---
import { getCollection } from 'astro:content';
import { t } from '../i18n';
import AvisoLicencia from './AvisoLicencia.astro';
import Icono from './Icono.astro';

// Autor principal para los enlaces sociales del pie (URLs aún placeholder).
const autor = (await getCollection('autores'))
  .filter((a) => a.data.activo)
  .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre))[0];

const sociales = autor
  ? [
      { red: 'linkedin' as const, url: autor.data.enlaces.linkedin, nombre: 'LinkedIn' },
      { red: 'github' as const, url: autor.data.enlaces.github, nombre: 'GitHub' },
    ]
  : [];
---
<footer class="mx-auto mt-16 max-w-5xl px-6 sm:px-10">
  <div class="border-t border-borde-fuerte pt-5">
    {/* --- Bloque 1: identidad y navegación (peso normal/alto) --- */}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-8">
      <div class="text-sm text-tinta-suave">
        <p class="m-0 text-tinta">{t('pie.hechoPor', { autor: 'Juan Ignacio García' })}</p>
        <p class="m-0 mt-1.5 max-w-sm text-pretty">{t('pie.tagline')}</p>
      </div>

      {/* M-2: cada enlace/ícono es un objetivo de toque de 44px con separación clara */}
      <div class="flex flex-wrap items-center gap-x-1 gap-y-1 -mx-2 sm:mx-0 sm:justify-end">
        <a href="/sobre" class="toque-comodo px-2 text-sm font-medium text-tinta hover:text-acento">{t('nav.sobre')}</a>
        <a href="/contacto" class="toque-comodo px-2 text-sm font-medium text-tinta hover:text-acento">{t('nav.contacto')}</a>
        {
          sociales.map((s) => (
            <a
              href={s.url}
              rel="me noopener"
              target="_blank"
              aria-label={`${s.nombre} de ${autor!.data.nombre}`}
              class="toque-comodo min-w-[44px] justify-center px-2 text-tinta-tenue hover:text-acento"
            >
              <Icono nombre={s.red} size={20} />
            </a>
          ))
        }
      </div>
    </div>

    {/* --- Bloque 2: metadata técnica y legal (peso bajo, no compite con el bloque 1) --- */}
    <div class="mt-5 flex flex-wrap items-start gap-x-3 gap-y-1 border-t border-borde pt-3 text-xs leading-relaxed text-tinta-tenue">
      <a href="/rss.xml" class="hover:text-acento">{t('pie.rss')}</a>
      <AvisoLicencia variante="pie" />
      <span>{new Date().getFullYear()}</span>
    </div>
  </div>
</footer>
