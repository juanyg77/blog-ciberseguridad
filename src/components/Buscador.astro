---
/**
 * RF-13 / D-9 — UI de Pagefind. El índice se genera en el build
 * (`pagefind --site dist`, ver package.json → script "build") desde el día 1.
 *
 * Pagefind se sirve desde /pagefind/ en el sitio compilado. En `astro dev` ese
 * directorio no existe todavía (hay que correr un build antes de `astro preview`);
 * el componente degrada de forma limpia si el script no está.
 *
 * Índice por idioma: Pagefind usa el atributo `lang` del <html> de cada página
 * para segmentar el índice (RF-9).
 */
interface Props {
  idioma?: string;
}
const { idioma = 'es' } = Astro.props;
---
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<div id="buscador-pagefind" data-idioma={idioma}></div>
<style is:global>
  /* Pagefind UI adaptado a la paleta y a móvil (font-size >= 16px en el input
     para que iOS no haga zoom). */
  #buscador-pagefind {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--color-tinta);
    --pagefind-ui-text: var(--color-tinta);
    --pagefind-ui-background: var(--color-papel);
    --pagefind-ui-border: var(--color-borde);
    --pagefind-ui-tag: var(--color-superficie);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 2px;
    --pagefind-ui-font: var(--font-sans);
  }
  #buscador-pagefind .pagefind-ui__search-input {
    font-size: 1rem;
    min-height: 44px;
  }
  #buscador-pagefind .pagefind-ui__result-link { color: var(--color-acento); }
</style>
{/*
  Default UI de Pagefind: pagefind-ui.js es un IIFE que setea window.PagefindUI
  (NO exporta nada como módulo ESM). Se carga con <script src> y se inicializa
  con window.PagefindUI. `is:inline` para que Astro no lo procese. Si el archivo
  no está (dev, o build sin índice) el onerror marca la falla y se muestra un
  mensaje neutro para el lector.
*/}
<script is:inline src="/pagefind/pagefind-ui.js" onerror="window.__pagefindFallo=true"></script>
<script is:inline>
  (function () {
    var el = document.getElementById('buscador-pagefind');
    if (!el) return;
    function fallback() {
      el.innerHTML =
        '<p class="text-sm text-tinta-tenue">El buscador no está disponible en este momento.</p>';
    }
    function init() {
      if (window.__pagefindFallo || typeof window.PagefindUI === 'undefined') {
        fallback();
        return;
      }
      try {
        new window.PagefindUI({
          element: '#buscador-pagefind',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: 'Buscá un tema, un caso, una amenaza…',
            zero_results: 'No se encontró nada para "[SEARCH_TERM]".',
          },
          ...(el.dataset.idioma ? { language: el.dataset.idioma } : {}),
        });
      } catch (e) {
        fallback();
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
