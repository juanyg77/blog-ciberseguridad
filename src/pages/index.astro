---
/**
 * Home. Eje de navegación: SECCIÓN (RF-2) y NIVEL (RF-1), nunca la fecha
 * (ARQUITECTURA.md 3.1). Muestra el aviso activo si lo hay (RF-11), un carrusel
 * de destacados arriba, y un listado cronológico SECUNDARIO ("Lo último").
 */
import { getCollection } from 'astro:content';
import LayoutBase from '../layouts/LayoutBase.astro';
import AvisoDestacado from '../components/AvisoDestacado.astro';
import CarruselDestacados from '../components/CarruselDestacados.astro';
import TarjetaArticulo from '../components/TarjetaArticulo.astro';
import { t } from '../i18n';
import {
  getArticulosPublicadosPorIdioma,
  getAvisoActivo,
  getArticulosPorSeccion,
} from '../lib/articulos';
import { seccionesNavegables } from '../lib/secciones';

const aviso = await getAvisoActivo();
const articulos = await getArticulosPublicadosPorIdioma('es');
const ultimos = articulos.slice(0, 6);

// Carrusel: hasta 4 destacados más recientes (los artículos ya vienen ordenados
// por fecha desc desde la consulta central).
const destacados = articulos.filter((a) => a.data.destacado).slice(0, 4);

// RF-2 — vitrina de secciones: solo si la navegación por sección está activa
// (>= 2 secciones; ver src/lib/secciones.ts).
const navSecciones = await seccionesNavegables();
const secciones = navSecciones
  ? (await getCollection('secciones')).sort(
      (a, b) => (a.data.orden ?? 99) - (b.data.orden ?? 99),
    )
  : [];
const conteoPorSeccion = new Map<string, number>();
for (const s of secciones) {
  conteoPorSeccion.set(s.id, (await getArticulosPorSeccion(s.id)).length);
}
---
<LayoutBase titulo={t('sitio.nombre')} descripcion={t('sitio.metaHome')}>
  {aviso && (
    <div class="mx-auto mb-10 max-w-3xl">
      <AvisoDestacado aviso={aviso} />
    </div>
  )}

  {destacados.length > 0 && <CarruselDestacados articulos={destacados} />}

  {/* Hero: tesis del blog + las dos puertas — CA-1 (1 clic a cada nivel) */}
  <section class="mt-14">
    <h1 class="max-w-2xl font-serif text-2xl font-semibold leading-snug sm:text-3xl">
      {t('home.heroH1')}
    </h1>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <div class="border-l-2 border-acento pl-4">
        <h2 class="font-serif text-xl font-semibold">{t('home.puertaAprenderTitulo')}</h2>
        <p class="mt-1 text-tinta-suave">{t('nivel.descripcion.aprender')}</p>
        <a href="/aprender" class="mt-2 inline-block border-b border-current text-sm text-acento">
          {t('home.puertaAprenderCta')} →
        </a>
      </div>
      <div class="border-l-2 border-borde pl-4">
        <h2 class="font-serif text-xl font-semibold">{t('home.puertaProfundizarTitulo')}</h2>
        <p class="mt-1 text-tinta-suave">{t('nivel.descripcion.profundizar')}</p>
        <a href="/profundizar" class="mt-2 inline-block border-b border-current text-sm text-acento">
          {t('home.puertaProfundizarCta')} →
        </a>
      </div>
    </div>
  </section>

  {/* Secciones (RF-2) — vitrina; solo cuando la navegación por sección está
      activa (>= 2 secciones). Con una sola sección se oculta: ver
      src/lib/secciones.ts. */}
  {navSecciones && (
    <section id="secciones" class="mt-14 scroll-mt-6">
      <div class="flex flex-col gap-1 border-b border-borde-fuerte pb-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
        <h2 class="font-serif text-2xl font-semibold">{t('home.explorarSecciones')}</h2>
        <a href="/secciones" class="font-mono text-[11px] uppercase tracking-[0.14em] text-acento hover:text-acento-fuerte">
          {t('home.verTodasLasSecciones')} →
        </a>
      </div>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {secciones.map((s) => (
          <a href={`/seccion/${s.id}`} class="block border-t border-borde pt-4 text-tinta hover:text-acento">
            <h3 class="font-serif text-lg font-semibold">{s.data.nombre}</h3>
            <p class="mt-1 text-sm text-tinta-suave">{s.data.descripcion}</p>
            <p class="mt-2 font-mono text-[10.5px] uppercase tracking-[0.12em] text-tinta-tenue">
              {t('secciones.conteo', { n: conteoPorSeccion.get(s.id) ?? 0 })}
            </p>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* Lo último — cronológico SECUNDARIO */}
  <section class="mt-14">
    <div class="flex flex-col gap-1 border-b border-borde-fuerte pb-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
      <h2 class="font-serif text-2xl font-semibold">{t('home.ultimo')}</h2>
      <a href="/recientes" class="font-mono text-[11px] uppercase tracking-[0.14em] text-acento hover:text-acento-fuerte">
        {t('home.todosLosArticulos')} →
      </a>
    </div>
    <div class="mt-6 grid gap-8 sm:grid-cols-2">
      {ultimos.map((a) => <TarjetaArticulo articulo={a} />)}
      {ultimos.length === 0 && <p class="text-tinta-tenue">{t('articulo.sinResultados')}</p>}
    </div>
  </section>
</LayoutBase>
