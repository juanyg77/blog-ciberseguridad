---
/** RF-13 / D-9 — Página de búsqueda (UI de Pagefind). */
import LayoutBase from '../layouts/LayoutBase.astro';
import Buscador from '../components/Buscador.astro';
import { t } from '../i18n';
---
<LayoutBase titulo={t('buscador.titulo')} descripcion={t('buscador.metaDescripcion')}>
  <div class="mx-auto max-w-2xl">
    <h1 class="border-b border-borde-fuerte pb-3 font-serif text-2xl font-semibold sm:text-3xl">
      {t('buscador.titulo')}
    </h1>
    <p class="mt-3 text-sm text-tinta-tenue">{t('buscador.ayuda')}</p>
    <div class="mt-6">
      <Buscador idioma="es" />
    </div>
  </div>
</LayoutBase>
