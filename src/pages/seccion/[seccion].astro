---
/**
 * RF-2 / CA-2 — Ruta ÚNICA para toda sección. Agregar una sección =
 * crear un archivo en src/content/secciones/ y etiquetar artículos.
 * Esta página y la navegación se generan solas. Cero cambios de diseño.
 */
import { getCollection } from 'astro:content';
import LayoutBase from '../../layouts/LayoutBase.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { t } from '../../i18n';
import { getArticulosPorSeccion } from '../../lib/articulos';

export async function getStaticPaths() {
  const secciones = await getCollection('secciones');
  return secciones.map((s) => ({ params: { seccion: s.id }, props: { seccion: s } }));
}

const { seccion } = Astro.props;
const articulos = await getArticulosPorSeccion(seccion.id, 'es');
---
<LayoutBase titulo={seccion.data.nombre} descripcion={seccion.data.descripcion}>
  <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-tinta-tenue">
    {t('nav.secciones')}
  </p>
  <h1 class="mt-2 border-b border-borde-fuerte pb-3 font-serif text-2xl font-semibold sm:text-3xl">
    {seccion.data.nombre}
  </h1>
  <p class="mt-3 max-w-2xl text-tinta-suave">{seccion.data.descripcion}</p>
  <div class="mt-8 grid gap-8 sm:grid-cols-2">
    {articulos.map((a) => <TarjetaArticulo articulo={a} />)}
    {articulos.length === 0 && <p class="text-tinta-tenue">{t('articulo.sinResultados')}</p>}
  </div>
</LayoutBase>
