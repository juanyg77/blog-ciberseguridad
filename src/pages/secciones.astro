---
/**
 * RF-2 / CA-2 — Página dedicada de secciones. Dos columnas:
 *  - Izquierda (sticky): lista de TODA la colección `secciones` con contador.
 *  - Derecha: artículos de la sección activa, con la misma tarjeta que "Lo último".
 *
 * El filtro se hace en el cliente sin recargar (isla mínima: ~30 líneas de JS
 * vanilla, sin framework). Sin JS degrada: los ítems de la izquierda son enlaces
 * reales a /seccion/[slug] (que ya existen) y a la derecha se ve la primera
 * sección.
 *
 * CA-2: todo se arma desde la colección. Agregar un archivo en
 * src/content/secciones/ suma su ítem, su contador y su panel sin tocar código.
 */
import { getCollection } from 'astro:content';
import LayoutBase from '../layouts/LayoutBase.astro';
import TarjetaArticulo from '../components/TarjetaArticulo.astro';
import { t } from '../i18n';
import { getArticulosPorSeccion } from '../lib/articulos';

const secciones = (await getCollection('secciones')).sort(
  (a, b) => (a.data.orden ?? 99) - (b.data.orden ?? 99) || a.data.nombre.localeCompare(b.data.nombre),
);

const datos = await Promise.all(
  secciones.map(async (s) => ({
    id: s.id,
    nombre: s.data.nombre,
    descripcion: s.data.descripcion,
    articulos: await getArticulosPorSeccion(s.id, 'es'),
  })),
);

const inicial = datos[0]?.id;
---
<LayoutBase titulo={t('secciones.titulo')} descripcion={t('secciones.intro')}>
  <h1 class="border-b border-borde-fuerte pb-3 font-serif text-2xl font-semibold sm:text-3xl">
    {t('secciones.titulo')}
  </h1>
  <p class="mt-3 max-w-2xl text-tinta-suave">{t('secciones.intro')}</p>

  {/* grid-cols-1 explícito + min-w-0 en ambos ítems: sin esto, en < lg cada
      ítem toma su ancho intrínseco (chips whitespace-nowrap, resúmenes en 1
      línea) y estira toda la página -> overflow horizontal recortado por
      body{overflow-x:clip} (C-1 / M-3). Con min-w-0 la tira scrollea sola. */}
  <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-[15rem_1fr]" data-secciones>
    {/* Panel de secciones: tira scrolleable en móvil, lista vertical sticky en desktop */}
    <nav
      class="min-w-0 -mx-6 border-y border-borde sm:mx-0 lg:sticky lg:top-6 lg:self-start lg:border-y-0"
      aria-label={t('secciones.titulo')}
    >
      <ul
        class="scroll-x-limpio flex gap-1 px-6 py-2 sm:px-0 lg:flex-col lg:gap-0 lg:overflow-visible lg:py-0"
      >
        {
          datos.map((s) => (
            <li class="shrink-0 lg:shrink">
              <a
                href={`/seccion/${s.id}`}
                data-seccion-link={s.id}
                aria-current={s.id === inicial ? 'true' : 'false'}
                class="toque-comodo whitespace-nowrap rounded border border-borde px-3 text-sm text-tinta transition-colors hover:text-acento data-[activa]:border-acento data-[activa]:text-acento lg:whitespace-normal lg:rounded-none lg:border-0 lg:border-l-2 lg:border-l-transparent lg:px-0 lg:pl-3 data-[activa]:lg:border-l-acento"
                data-activa={s.id === inicial ? '' : undefined}
              >
                {s.nombre}
                <span class="ml-1 font-mono text-[11px] text-tinta-tenue">({s.articulos.length})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Paneles de artículos, uno por sección */}
    <div class="min-w-0">
      {
        datos.map((s) => (
          <section
            data-seccion-panel={s.id}
            hidden={s.id !== inicial}
            aria-label={s.nombre}
          >
            <h2 class="font-serif text-2xl font-semibold">{s.nombre}</h2>
            <p class="mt-1 max-w-2xl text-sm text-tinta-suave">{s.descripcion}</p>
            <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.12em] text-tinta-tenue">
              {t('secciones.conteo', { n: s.articulos.length })}
              {' · '}
              <a href={`/seccion/${s.id}`} class="hover:text-acento">/seccion/{s.id}</a>
            </p>
            <div class="mt-6 grid gap-8 sm:grid-cols-2">
              {s.articulos.map((a) => (
                <TarjetaArticulo articulo={a} />
              ))}
              {s.articulos.length === 0 && (
                <p class="text-tinta-tenue">{t('secciones.vacia')}</p>
              )}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</LayoutBase>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-secciones]');
  if (raiz) {
    const links = Array.from(raiz.querySelectorAll<HTMLAnchorElement>('[data-seccion-link]'));
    const paneles = Array.from(raiz.querySelectorAll<HTMLElement>('[data-seccion-panel]'));

    const activar = (id: string, foco = false) => {
      let hubo = false;
      paneles.forEach((p) => {
        const on = p.dataset.seccionPanel === id;
        p.hidden = !on;
        if (on) hubo = true;
      });
      if (!hubo) return;
      links.forEach((l) => {
        const on = l.dataset.seccionLink === id;
        l.toggleAttribute('data-activa', on);
        l.setAttribute('aria-current', on ? 'true' : 'false');
      });
      if (foco) {
        const panel = paneles.find((p) => p.dataset.seccionPanel === id);
        panel?.querySelector('h2')?.setAttribute('tabindex', '-1');
        (panel?.querySelector('h2') as HTMLElement | undefined)?.focus();
      }
    };

    links.forEach((l) => {
      l.addEventListener('click', (e) => {
        const id = l.dataset.seccionLink;
        if (!id) return;
        e.preventDefault();
        activar(id, true);
        history.replaceState(null, '', `#${id}`);
      });
    });

    const inicial = decodeURIComponent(location.hash.slice(1));
    if (inicial) activar(inicial);
  }
</script>
