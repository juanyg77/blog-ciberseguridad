---
import LayoutBase from '../../layouts/LayoutBase.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { t } from '../../i18n';
import { getArticulosPorNivel } from '../../lib/articulos';

// Ruta /aprender (slug = valor del campo `nivel`). Etiqueta: t('nav.aprender').
const articulos = await getArticulosPorNivel('aprender', 'es');
const descripcion = t('nivel.descripcion.aprender');
---
<LayoutBase titulo={t('nav.aprender')} descripcion={descripcion}>
  <h1 class="border-b border-borde-fuerte pb-3 font-serif text-2xl font-semibold sm:text-3xl">
    {t('nav.aprender')}
  </h1>
  <p class="mt-3 max-w-2xl text-tinta-suave">{descripcion}</p>
  <div class="mt-8 grid gap-8 sm:grid-cols-2">
    {articulos.map((a) => <TarjetaArticulo articulo={a} />)}
    {articulos.length === 0 && <p class="text-tinta-tenue">{t('articulo.sinResultados')}</p>}
  </div>
</LayoutBase>
