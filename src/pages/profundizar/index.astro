---
import LayoutBase from '../../layouts/LayoutBase.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { t } from '../../i18n';
import { getArticulosPorNivel } from '../../lib/articulos';

// Ruta /profundizar (slug = valor del campo `nivel`). Etiqueta: t('nav.profundizar').
const articulos = await getArticulosPorNivel('profundizar', 'es');
const descripcion = t('nivel.descripcion.profundizar');
---
<LayoutBase titulo={t('nav.profundizar')} descripcion={descripcion}>
  <h1 class="border-b border-borde-fuerte pb-3 font-serif text-2xl font-semibold sm:text-3xl">
    {t('nav.profundizar')}
  </h1>
  <p class="mt-3 max-w-2xl text-tinta-suave">{descripcion}</p>
  <div class="mt-8 grid gap-x-6 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">
    {articulos.map((a) => <TarjetaArticulo articulo={a} variante="grilla" />)}
    {articulos.length === 0 && <p class="text-tinta-tenue">{t('articulo.sinResultados')}</p>}
  </div>
</LayoutBase>
