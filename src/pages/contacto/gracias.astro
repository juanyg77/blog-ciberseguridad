---
/** CA-8b — Confirmación de envío. Web3Forms redirige acá tras un envío válido. */
import LayoutBase from '../../layouts/LayoutBase.astro';
import { t } from '../../i18n';
---
<LayoutBase titulo={t('contacto.graciasTitulo')} descripcion={t('contacto.graciasTexto')} noindex={true}>
  <div class="mx-auto max-w-xl">
    <h1 class="font-serif text-2xl font-semibold sm:text-3xl">{t('contacto.graciasTitulo')}</h1>
    <p class="mt-4 text-tinta-suave">{t('contacto.graciasTexto')}</p>
    <p class="mt-8">
      <a href="/" class="border-b border-current">← {t('contacto.graciasVolver')}</a>
    </p>
  </div>
</LayoutBase>
