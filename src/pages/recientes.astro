---
/**
 * ARQUITECTURA.md 3.1 — Listado cronológico SECUNDARIO (no es la columna
 * vertebral del sitio). Todos los artículos publicados, más nuevos primero.
 */
import LayoutBase from '../layouts/LayoutBase.astro';
import TarjetaArticulo from '../components/TarjetaArticulo.astro';
import { t } from '../i18n';
import { getArticulosPublicadosPorIdioma } from '../lib/articulos';

const articulos = await getArticulosPublicadosPorIdioma('es');
---
<LayoutBase titulo={t('nav.recientes')} descripcion="Todos los artículos, del más nuevo al más viejo.">
  <div class="flex flex-col gap-1 border-b border-borde-fuerte pb-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
    <h1 class="font-serif text-2xl font-semibold sm:text-3xl">{t('nav.recientes')}</h1>
    <a href="/rss.xml" class="font-mono text-[11px] uppercase tracking-[0.14em] text-tinta-tenue hover:text-acento">RSS →</a>
  </div>
  <div class="mt-8 grid gap-8 sm:grid-cols-2">
    {articulos.map((a) => <TarjetaArticulo articulo={a} />)}
    {articulos.length === 0 && <p class="text-tinta-tenue">{t('articulo.sinResultados')}</p>}
  </div>
</LayoutBase>
