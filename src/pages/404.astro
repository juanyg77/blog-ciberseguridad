---
import LayoutBase from '../layouts/LayoutBase.astro';
import { t } from '../i18n';
---
<LayoutBase titulo={t('error404.titulo')} noindex={true}>
  <div class="mx-auto max-w-xl py-10">
    <p class="font-mono text-sm text-tinta-tenue">404</p>
    <h1 class="mt-2 font-serif text-2xl font-semibold sm:text-3xl">{t('error404.titulo')}</h1>
    <p class="mt-4 text-tinta-suave">{t('error404.texto')}</p>
    <p class="mt-8"><a href="/" class="border-b border-current text-acento">← {t('error404.volver')}</a></p>
  </div>
</LayoutBase>
