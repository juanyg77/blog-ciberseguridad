---
/**
 * RF-8 / CA-8 — Formulario de contacto (ARQUITECTURA.md sección 6).
 * <form> que postea a Web3Forms (D-14). Tras enviar, redirección a
 * /contacto/gracias (CA-8b).
 *
 * Anti-spam:
 *  - honeypot (`botcheck`) — Web3Forms descarta el envío si viene lleno;
 *  - hCaptcha vía la integración GRATUITA de Web3Forms (`<div class="h-captcha">`
 *    + su script). No requiere cuenta propia de hCaptcha ni site key en el repo:
 *    la key del plan gratis va hardcodeada en el script de Web3Forms. El método
 *    de captcha se elige en el panel de Web3Forms.
 *  (Reemplaza a Cloudflare Turnstile: conectar Turnstile a Web3Forms requiere su
 *   plan Pro; hCaptcha es gratis.)
 *
 * Secreto como variable de entorno, NUNCA en el repo (D-18):
 *   PUBLIC_WEB3FORMS_ACCESS_KEY   access key de Web3Forms
 * Ver .env.example.
 */
import LayoutBase from '../layouts/LayoutBase.astro';
import { t } from '../i18n';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
const site = Astro.site ?? new URL('https://elquelassabetodas.com');
const redirect = new URL('/contacto/gracias', site).toString();
// min-h 44px + font-size 1rem (global) => buen toque y sin zoom en iOS.
// border-borde-fuerte en reposo: en oscuro #borde (1.36:1) era casi invisible (M-1).
const inputCls =
  'mt-1 block w-full min-h-[44px] border border-borde-fuerte bg-papel px-3 py-2.5 text-tinta outline-none focus:border-acento focus:ring-1 focus:ring-acento [&:user-invalid]:border-error';
const labelCls = 'block text-sm font-medium';
---
<LayoutBase titulo={t('contacto.titulo')} descripcion={t('contacto.intro')}>
  <div class="mx-auto max-w-xl">
    <h1 class="border-b border-borde-fuerte pb-3 font-serif text-2xl font-semibold sm:text-3xl">
      {t('contacto.titulo')}
    </h1>
    <p class="mt-3 text-tinta-suave">{t('contacto.intro')}</p>

    {/* Recordatorio SOLO en desarrollo — el visitante nunca lo ve. */}
    {import.meta.env.DEV && !accessKey && (
      <p class="mt-6 border-l-2 border-acento bg-superficie px-4 py-3 text-sm text-tinta-suave">
        [dev] Falta <code>PUBLIC_WEB3FORMS_ACCESS_KEY</code>. El formulario se
        muestra pero no envía hasta cargar la clave como variable de entorno (D-18).
      </p>
    )}

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="mt-8 space-y-5"
      id="form-contacto"
    >
      <input type="hidden" name="access_key" value={accessKey ?? 'PENDIENTE'} />
      <input type="hidden" name="redirect" value={redirect} />
      <input type="hidden" name="subject" value="Nuevo mensaje desde El Que Se Las Sabe Todas" />
      <input type="hidden" name="from_name" value="El Que Se Las Sabe Todas — formulario de contacto" />

      {/* Honeypot (Web3Forms lo descarta si viene lleno) */}
      <input
        type="checkbox"
        name="botcheck"
        tabindex="-1"
        autocomplete="off"
        class="hidden"
        aria-hidden="true"
      />

      <div>
        <label for="nombre" class={labelCls}>{t('contacto.nombre')}</label>
        <input id="nombre" name="name" type="text" required class={inputCls} />
      </div>
      <div>
        <label for="email" class={labelCls}>{t('contacto.email')}</label>
        <input id="email" name="email" type="email" required class={inputCls} />
      </div>
      <div>
        <label for="asunto" class={labelCls}>{t('contacto.asunto')}</label>
        <input id="asunto" name="asunto" type="text" class={inputCls} />
      </div>
      <div>
        <label for="mensaje" class={labelCls}>{t('contacto.mensaje')}</label>
        <textarea id="mensaje" name="message" rows="6" required class={inputCls}></textarea>
      </div>

      {/* hCaptcha — integración gratuita de Web3Forms (ver comentario del head) */}
      <div class="h-captcha" data-captcha="true"></div>
      <p id="captcha-error" hidden role="alert" class="text-sm font-medium text-error">
        {t('contacto.captchaFalta')}
      </p>

      <button
        type="submit"
        class="min-h-[44px] w-full border border-borde-fuerte bg-tinta px-5 py-2.5 font-medium text-papel hover:border-acento hover:bg-acento sm:w-auto"
      >
        {t('contacto.enviar')}
      </button>
      <p id="form-error" hidden role="alert" class="text-sm font-medium text-error">{t('contacto.errorEnvio')}</p>
    </form>

    <p class="mt-6 text-sm text-tinta-tenue">
      {t('contacto.otroCanal')}{' '}
      <a href={`mailto:${t('contacto.casilla')}`} class="border-b border-current text-acento">
        {t('contacto.casilla')}
      </a>.
    </p>
  </div>

  {/* Script de Web3Forms: renderiza el widget de hCaptcha y agrega el campo
      h-captcha-response al form. */}
  <script is:inline src="https://web3forms.com/client/script.js" async defer></script>

  {/* No dejar enviar sin resolver el captcha. */}
  <script is:inline>
    (function () {
      var form = document.getElementById('form-contacto');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        var resp = form.querySelector('textarea[name="h-captcha-response"]');
        var err = document.getElementById('captcha-error');
        if (!resp || !resp.value) {
          e.preventDefault();
          if (err) err.hidden = false;
        }
      });
    })();
  </script>
</LayoutBase>
