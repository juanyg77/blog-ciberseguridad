---
/**
 * RF-8 / CA-8 — Formulario de contacto (ARQUITECTURA.md sección 6).
 * <form> que postea a Web3Forms (D-14). Anti-spam: honeypot (`botcheck`) +
 * Cloudflare Turnstile. Tras enviar, redirección a /contacto/gracias (CA-8b).
 *
 * Secretos como variables de entorno, NUNCA en el repo (D-18):
 *   PUBLIC_WEB3FORMS_ACCESS_KEY   access key de Web3Forms
 *   PUBLIC_TURNSTILE_SITE_KEY     site key de Turnstile (opcional pero recomendado)
 * Ver .env.example.
 */
import LayoutBase from '../layouts/LayoutBase.astro';
import { t } from '../i18n';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const site = Astro.site ?? new URL('https://elquelassabetodas.com');
const redirect = new URL('/contacto/gracias', site).toString();
// min-h 44px + font-size 1rem (global) => buen toque y sin zoom en iOS
const inputCls =
  'mt-1 block w-full min-h-[44px] border border-borde bg-papel px-3 py-2.5 text-tinta outline-none focus:border-acento focus:ring-1 focus:ring-acento [&:user-invalid]:border-error';
const labelCls = 'block text-sm font-medium';
---
<LayoutBase titulo={t('contacto.titulo')} descripcion={t('contacto.intro')}>
  <div class="mx-auto max-w-xl">
    <h1 class="border-b border-borde-fuerte pb-3 font-serif text-2xl font-semibold sm:text-3xl">
      {t('contacto.titulo')}
    </h1>
    <p class="mt-3 text-tinta-suave">{t('contacto.intro')}</p>

    {!accessKey && (
      <p class="mt-6 border-l-2 border-acento bg-superficie px-4 py-3 text-sm text-tinta-suave">
        Falta configurar <code>PUBLIC_WEB3FORMS_ACCESS_KEY</code>. El formulario se
        muestra pero no envía hasta cargar la clave como variable de entorno (D-18).
      </p>
    )}

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="mt-8 space-y-5"
      id="form-contacto"
    >
      <input type="hidden" name="access_key" value={accessKey ?? 'PENDIENTE'} />
      <input type="hidden" name="redirect" value={redirect} />
      <input type="hidden" name="subject" value="Nuevo mensaje desde El Que Se Las Sabe Todas" />
      <input type="hidden" name="from_name" value="El Que Se Las Sabe Todas — formulario de contacto" />

      {/* Honeypot (Web3Forms lo descarta si viene lleno) */}
      <input
        type="checkbox"
        name="botcheck"
        tabindex="-1"
        autocomplete="off"
        class="hidden"
        aria-hidden="true"
      />

      <div>
        <label for="nombre" class={labelCls}>{t('contacto.nombre')}</label>
        <input id="nombre" name="name" type="text" required class={inputCls} />
      </div>
      <div>
        <label for="email" class={labelCls}>{t('contacto.email')}</label>
        <input id="email" name="email" type="email" required class={inputCls} />
      </div>
      <div>
        <label for="asunto" class={labelCls}>{t('contacto.asunto')}</label>
        <input id="asunto" name="asunto" type="text" class={inputCls} />
      </div>
      <div>
        <label for="mensaje" class={labelCls}>{t('contacto.mensaje')}</label>
        <textarea id="mensaje" name="message" rows="6" required class={inputCls}></textarea>
      </div>

      {turnstileKey && (
        <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="auto"></div>
      )}

      <button
        type="submit"
        class="min-h-[44px] w-full border border-borde-fuerte bg-tinta px-5 py-2.5 font-medium text-papel hover:border-acento hover:bg-acento sm:w-auto"
      >
        {t('contacto.enviar')}
      </button>
      <p id="form-error" hidden role="alert" class="text-sm font-medium text-error">{t('contacto.errorEnvio')}</p>
    </form>

    <p class="mt-6 text-sm text-tinta-tenue">
      {t('contacto.otroCanal')}{' '}
      <a href={`mailto:${t('contacto.casilla')}`} class="border-b border-current">
        {t('contacto.casilla')}
      </a>.
    </p>
  </div>

  {turnstileKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}
</LayoutBase>
